# Stellar Testnet (public)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_QRP_ISSUER=
NEXT_PUBLIC_QRP_CODE=QRP
NEXT_PUBLIC_QRP_DISTRIBUTOR=
NEXT_PUBLIC_QRP_ADMIN=

# Server-only: never expose these to the browser / NEXT_PUBLIC_*
QHAPAQ_DISTRIBUTOR_SECRET_KEY=
QHAPAQ_REDEMPTION_SECRET_KEY=
QHAPAQ_ADMIN_SECRET_KEY=

# IPFS / Pinata (server-only — never NEXT_PUBLIC_*)
# PINATA_JWT = the LONG JWT from https://app.pinata.cloud/developers/api-keys
# (starts with eyJ… and has three dot-separated parts). Do NOT paste the short
# pinata_api_key here — that causes 401 / “No se pudo subir la evidencia”.
PINATA_JWT=
# Optional; unused by the app (SDK auth is JWT-only). Kept for local notes.
PINATA_API_KEY=

# Public Pinata gateway host only (no JWT). Example: abc123.mypinata.cloud
NEXT_PUBLIC_GATEWAY_URL=
